# Copia este archivo como .env y completa los valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# ── Base de datos (Oracle local, ver Database/KarbonZeroInstitucional.sql) ──
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USER=KARBONZERO_INST
DB_PASSWORD=tu_contraseña
DB_DRIVER=oracle.jdbc.OracleDriver

# ── Servidor ─────────────────────────────────────────────────────
# Opcional: por defecto 8081 (la API central usa 8080).
SERVER_PORT=8081

# ── JWT ──────────────────────────────────────────────────────────
SECRET_KEY_JWT=una_clave_secreta_larga_y_dificil_de_adivinar_de_al_menos_32_caracteres
SECURITY_JWT_ISSUER=karbonZeroInstitutional
JWT_EXPIRATION=86400000

# ── Cookie de sesión ─────────────────────────────────────────────
# Vacío en local. En producción, el dominio público de esta API.
COOKIE_DOMAIN=

# ── Correo saliente (Gmail con contraseña de aplicación) ─────────
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion

# ── API central de KarbonZero ────────────────────────────────────
# Valores de la empresa de demostración "Ricaldone" que trae Database/KarbonZero.sql
# (repositorio KarbonZero_BackendMobile). EXTERNAL_DOMAIN debe coincidir con su BACKENDDOMAIN.
EXTERNAL_API_KEY=fdc7241db6bf9adb2809b3dac525ba1c
EXTERNAL_DOMAIN=http://localhost:8081
EXTERNAL_ADMIN_DOMAIN=http://localhost:8080

# ── Cloudinary (opcional, solo para subir imágenes) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
